# ── AI Smart Traffic Monitor — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to git (it's in .gitignore)

# ── Camera settings ───────────────────────────────────────────────────────────
CAMERA_ID=NTPC_CAM_01
RTSP_STREAM_URL=rtsp://username:password@192.168.1.100:554/stream

# ── Speed limits (km/h) ───────────────────────────────────────────────────────
SPEED_LIMIT_CAR=40
SPEED_LIMIT_TRUCK=30
SPEED_LIMIT_BUS=30
SPEED_LIMIT_MOTORCYCLE=35

# ── Detection lines ───────────────────────────────────────────────────────────
ENTRY_LINE_Y=280
EXIT_LINE_Y=600
REAL_DISTANCE_METERS=5.0

# ── Model paths ───────────────────────────────────────────────────────────────
VEHICLE_MODEL_PATH=models/yolov8n.pt
PLATE_MODEL_PATH=models/plate_best.pt
HELMET_MODEL_PATH=models/helmet_best.pt

# ── API settings ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Alerts (optional) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALERT_EMAIL=alerts@yourdomain.com
